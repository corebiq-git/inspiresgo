rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    // Test connection probe allowed for healthcheck
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidId(userId);
      allow list: if isAuthenticated();

      // Subcollection: Bookings
      match /bookings/{bookingId} {
        allow read, write: if isOwner(userId) && isValidId(bookingId);
      }

      // Subcollection: Visa Applications
      match /visaApplications/{applicationId} {
        allow read, write: if isOwner(userId) && isValidId(applicationId);
      }

      // Subcollection: Saved Items (Wishlist)
      match /savedItems/{savedId} {
        allow read, write: if isOwner(userId) && isValidId(savedId);
      }
    }
  }
}
